#!/bin/sh
# Run Make It So from a checkout of main, with ~/.config/mis/orchestrator.env.
#   mis-up               orchestrator only (LAN workers connect to ws://<this-mac>:7474)
#   mis-up --tunnel      also run `cloudflared tunnel run mis` for phone access
#   mis-up --worker      also run a local worker on ~/code (tools run without prompts)
#   mis-up --update      fast-forward main from origin first
#   mis-up --watch       every MIS_UPDATE_INTERVAL s (300): when origin/main moves, pull and build;
#                        the page then shows Update ready. Once the owner taps Update and no task
#                        runs, restart the orchestrator and local worker on it (the tunnel stays
#                        up); Roll back returns to the build before. A failed build keeps the
#                        running version; one that exits within 30 s is dropped. Started again, it
#                        resumes the build last chosen, not the checkout's.
#   mis-up --auto-update with --watch, start a ready build once no task runs, without the owner
#   mis-up --no-tray     don't start the menu bar app (started by default on macOS, restarted with
#                        each update; not with --worker-only)
#   mis-up --worker-only just a worker; other args go to mis-worker (e.g. --url). With --watch a
#                        remote machine updates on its own once no task runs anywhere.
# Other args pass through to mis-orchestrator. Builds $MIS_REPO (default ~/code/make-it-so) only
# when it is on main with no local changes: agents switch branches there. Each build's binaries
# are copied to <state dir>/builds/<sha> and run from there, so a build never swaps a running one.
set -e
REPO=${MIS_REPO:-$HOME/code/make-it-so}
ENV_FILE=$HOME/.config/mis/orchestrator.env
tunnel=0 worker=0 update=0 watch=0 only=0 auto=false url='' pass=''
tray=0; [ "$(uname -s)" = Darwin ] && tray=1
while [ $# -gt 0 ]; do
  case $1 in
    --tunnel) tunnel=1 ;;
    --worker) worker=1 ;;
    --update) update=1 ;;
    --watch) watch=1 ;;
    --auto-update) auto=true ;;
    --worker-only) only=1 ;;
    --no-tray) tray=0 ;;
    --url) url=$2 pass="$pass $1 $2"; shift ;;
    --url=*) url=${1#--url=} pass="$pass $1" ;;
    *) pass="$pass $1" ;;
  esac
  shift
done
# A remote worker may have no orchestrator env file.
# shellcheck source=/dev/null
if [ $only = 0 ] || [ -f "$ENV_FILE" ]; then set -a; . "$ENV_FILE"; set +a; fi
# Binaries here update by rebuilding this repo, never from releases. Env, not flags: older builds
# (kept for rollback) don't know them. The orchestrator still names the edge channel: a repo build
# can't replace itself (not built by CI), but release-built remote workers then follow this commit.
export MIS_NO_SELF_UPDATE=1
export MIS_UPDATE_CHANNEL="${MIS_UPDATE_CHANNEL:-edge}"
BIND=${MIS_BIND:-127.0.0.1:7474}
STATE=${MIS_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/mis}
BUILDS=$STATE/builds
TARGET=${CARGO_TARGET_DIR:-$REPO/target}
INTERVAL=${MIS_UPDATE_INTERVAL:-300}
if [ $only = 1 ]; then
  bins=mis-worker
  url=${url:-${MIS_URL:-}}
  case $url in ws*) url=http${url#ws} ;; esac
else
  bins="mis-orchestrator mis-worker"
  [ $tray = 1 ] && bins="$bins mis-tray"
  url=http://127.0.0.1:${BIND##*:}
fi

log() { echo "mis-up: $*" >&2; }
short() { echo "$1" | cut -c1-7; }
on_clean_main() {
  [ "$(git -C "$REPO" branch --show-current)" = main ] && [ -z "$(git -C "$REPO" status --porcelain)" ]
}

# Build HEAD and copy its binaries to $BUILDS/<sha>.
build() {
  sha=$(git -C "$REPO" rev-parse HEAD)
  log "building $REPO @ $(git -C "$REPO" log -1 --format='%h %s')"
  pkgs=; for b in $bins; do pkgs="$pkgs -p $b"; done
  # shellcheck disable=SC2086
  cargo build -q $pkgs --manifest-path "$REPO/Cargo.toml" || return 1
  rm -rf "$BUILDS/.new" "${BUILDS:?}/$sha"
  mkdir -p "$BUILDS/.new"
  for b in $bins; do cp "$TARGET/debug/$b" "$BUILDS/.new/" || return 1; done
  mv "$BUILDS/.new" "$BUILDS/$sha"
}

# Start build $1's orchestrator and local worker (or just the worker); `main` is the one to watch.
start() {
  touch "$BUILDS/$1" # most recently used: kept by prune
  if [ $only = 1 ]; then
    # shellcheck disable=SC2086
    "$BUILDS/$1/mis-worker" $pass &
    wpid=$! main=$!
    return
  fi
  # shellcheck disable=SC2086
  "$BUILDS/$1/mis-orchestrator" --bind "$BIND" $pass &
  orch=$! main=$!
  if [ $worker = 1 ]; then
    ( sleep 2; exec "$BUILDS/$1/mis-worker" --url "ws://127.0.0.1:${BIND##*:}" --root "$HOME/code" --skip-permissions ) &
    wpid=$!
  fi
  # The tray reads the URL and token from the env file; older builds (rollback) may lack it.
  if [ $tray = 1 ] && [ -x "$BUILDS/$1/mis-tray" ]; then
    "$BUILDS/$1/mis-tray" >/dev/null 2>&1 &
    trpid=$!
  fi
}

# SIGTERM pid $1 and wait for it to exit (the orchestrator saves its ledger); SIGKILL after 10 s.
stop() {
  [ -n "$1" ] && kill "$1" 2>/dev/null || return 0
  i=0
  while kill -0 "$1" 2>/dev/null && [ $i -lt 100 ]; do sleep 0.1; i=$((i + 1)); done
  kill -9 "$1" 2>/dev/null || true
  wait "$1" 2>/dev/null || true
}

restart() {
  stop "$trpid"; stop "$wpid"; stop "$orch"
  trpid='' wpid='' orch=''
  start "$1"
}

# Auth headers for curl, fed on stdin so the token never shows in argv.
headers() {
  [ -n "${MIS_TOKEN:-}" ] && printf 'Authorization: Bearer %s\n' "$MIS_TOKEN"
  [ -n "${CF_ACCESS_CLIENT_ID:-}" ] && printf 'CF-Access-Client-Id: %s\nCF-Access-Client-Secret: %s\n' \
    "$CF_ACCESS_CLIENT_ID" "${CF_ACCESS_CLIENT_SECRET:-}"
  true
}

# Escape stdin for a JSON string.
esc() { sed 's/\\/\\\\/g; s/"/\\"/g'; }

# Tell the local orchestrator about update $2 (failed, rolled_back); the page shows it.
report() {
  [ $only = 1 ] && return 0
  subject=$(git -C "$REPO" log -1 --format=%s "$2" | tr -d '\000-\037' | esc)
  body="{\"state\":\"$1\",\"sha\":\"$2\",\"subject\":\"$subject\"}"
  headers | curl -sf -m 10 -o /dev/null -H @- --data-binary "$body" "$url/api/update" ||
    log "could not report '$1' to $url"
}

# Tasks a restart would interrupt, fleet-wide; empty if the orchestrator can't be asked.
running() {
  headers | curl -sf -m 10 -H @- "$url/api/update" | sed -n 's/.*"running":\([0-9][0-9]*\).*/\1/p'
}

# Sleep $1 s; if the watched process exits meanwhile, exit with its status, as a plain run would.
nap() {
  slept=0
  while [ $slept -lt "$1" ]; do
    if ! kill -0 "$main" 2>/dev/null; then
      st=0; wait "$main" || st=$?
      log "exited ($st)"; exit $st
    fi
    sleep 1; slept=$((slept + 1))
  done
}

# Healthy: still running 30 s after start. Meanwhile it hears the builds report, so the page
# shows the new build at once.
healthy() {
  i=0
  while [ $i -lt 30 ]; do
    kill -0 "$main" 2>/dev/null || return 1
    [ $only = 1 ] || next >/dev/null
    sleep 1; i=$((i + 1))
  done
}

# Keep the running, previous and ready builds.
prune() {
  for d in "$BUILDS"/*; do
    case ${d##*/} in "$cur" | "$prev" | "$ready") ;; *) rm -rf "$d" ;; esac
  done
}

# The running and previous builds, for a restart of mis-up and for Roll back.
save() { printf '%s %s\n' "$cur" "$prev" >"$BUILDS/.state.new" && mv "$BUILDS/.state.new" "$BUILDS/.state"; }

# Commits $1..$2, newest first (at most 50), as JSON [{"sha","subject","ci"}]; ci from $ci.
commits() {
  [ -n "$1" ] && [ -n "$2" ] || { printf '[]'; return; }
  git -C "$REPO" log -50 --format='%H %s' "$1..$2" | tr -d '\000-\011\013-\037' | esc |
    CI=$ci awk 'BEGIN { n = split(ENVIRON["CI"], l, "\n"); for (i = n; i > 0; i--) { split(l[i], f, " "); c[f[1]] = f[2] } }
      { printf "%s{\"sha\":\"%s\",\"subject\":\"%s\"%s}", (NR > 1 ? "," : "["), $1, substr($0, length($1) + 2),
          (c[$1] ? ",\"ci\":\"" c[$1] "\"" : "") }
      END { printf "%s", NR ? "]" : "[]" }'
}

# Main's CI runs, newest first, as "<sha> passing|failing|pending" lines in $ci; kept if gh
# can't say within 20 s.
checks() {
  command -v gh >/dev/null || return 0
  # shellcheck disable=SC2016 # jq's own $c
  (cd "$REPO" && exec gh run list --branch main --limit 50 --json headSha,status,conclusion --jq '.[] |
    (if .status != "completed" then "pending" elif .conclusion == "success" then "passing"
     elif .conclusion == "failure" or .conclusion == "timed_out" then "failing" else empty end) as $c |
    "\(.headSha) \($c)"') >"$BUILDS/.ci" 2>/dev/null &
  p=$! i=0
  while kill -0 $p 2>/dev/null && [ $i -lt 20 ]; do sleep 1; i=$((i + 1)); done
  kill $p 2>/dev/null
  wait $p && ci=$(cat "$BUILDS/.ci")
}
str() { if [ -n "$1" ]; then printf '"%s"' "$1"; else printf null; fi; }

# The builds report (mis_types::Builds), rebuilt when the builds change.
describe() {
  [ -d "$BUILDS/$prev" ] || prev=''
  origin=$(git -C "$REPO" config --get remote.origin.url | tr -d '\000-\037' | esc)
  builds=$(printf '{"running":"%s","started":"%s","ready":%s,"previous":%s,"incoming":%s,"outgoing":%s,"origin":"%s","auto":%s}' \
    "$cur" "$how" "$(str "$ready")" "$(str "$prev")" "$(commits "$cur" "$ready")" "$(commits "$prev" "$cur")" "$origin" "$auto")
}

# Main's build is ready unless it runs; build it (once) if it isn't yet.
consider() {
  head=$(git -C "$REPO" rev-parse HEAD)
  if [ "$head" = "$cur" ]; then
    ready=''
  elif [ -d "$BUILDS/$head" ]; then
    ready=$head
  elif [ "$head" != "$tried" ]; then
    tried=$head
    if build; then
      ready=$head
    else
      log "build failed; still running $(short "$cur")"
      report failed "$head"
    fi
  fi
  describe
  prune
}

# The build to start now, if any: the orchestrator's answer to the builds report. A worker-only
# machine has no say there: its ready build starts once no task runs anywhere.
next() {
  if [ $only = 1 ]; then
    [ -n "$ready" ] && [ "$(running)" = 0 ] && echo "$ready"
    return 0
  fi
  if ! answer=$(headers | curl -sf -m 10 -H @- --data-binary "$builds" "$url/api/update/builds"); then
    [ -n "$told" ] || log "can't report builds to $url/api/update/builds; retrying"
    told=1
    return 0
  fi
  told=''
  echo "$answer" | sed -n 's/.*"start":"\([0-9a-f]*\)".*/\1/p'
}

# Restart on build $1 (ready: Update, previous: Roll back). One that exits within 30 s is
# dropped, and the running build starts again.
go() {
  if [ "$1" = "$ready" ]; then to=update; else to=roll_back; fi
  log "restarting on $(short "$1") ($to)"
  was_cur=$cur was_prev=$prev was_how=$how
  prev=$cur cur=$1 how=$to ready=''
  [ $to = roll_back ] && ready=$prev # Update brings it back
  describe
  restart "$cur"
  if healthy; then
    save
  else
    log "$(short "$cur") exited within 30 s; back on $(short "$was_cur")"
    rm -rf "${BUILDS:?}/$cur"
    cur=$was_cur prev=$was_prev how=$was_how ready=''
    restart "$cur"
    # Report once it is listening again.
    tries=0; until [ -n "$(running)" ] || [ $tries -ge 20 ]; do nap 1; tries=$((tries + 1)); done
    report rolled_back "$1"
  fi
  if on_clean_main; then consider; else describe; fi
}

if [ $watch = 1 ] && [ -z "$url" ]; then
  echo "mis-up: --worker-only --watch needs --url or MIS_URL to ask when no task runs" >&2
  exit 1
fi
if ! on_clean_main; then
  branch=$(git -C "$REPO" branch --show-current)
  echo "mis-up: $REPO is on '${branch:-detached}'$( [ -n "$(git -C "$REPO" status --porcelain)" ] && echo ' with local changes'); want main, clean." >&2
  echo "        An agent may be working there. Try again when it's done, or: git -C $REPO checkout main" >&2
  exit 1
fi
[ $update = 1 ] && git -C "$REPO" pull -q --ff-only
mkdir -p "$BUILDS"
cur='' prev='' ready='' tried='' how=launch ci='' told=''
[ -f "$BUILDS/.state" ] && read -r cur prev <"$BUILDS/.state" || true
if [ $watch = 1 ] && [ -n "$cur" ] && [ -d "$BUILDS/$cur" ]; then
  # What main gained since waits for the owner, as it would have had this kept running.
  log "resuming $(short "$cur")"
else
  last=$cur
  build || exit 1
  cur=$sha
  [ "$last" = "$cur" ] || prev=$last
fi
save
tpid='' orch='' wpid='' trpid='' main=''
trap 'kill $tpid $orch $wpid $trpid 2>/dev/null || true' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
if [ $tunnel = 1 ]; then
  cloudflared tunnel run mis >"$HOME/.config/mis/cloudflared.log" 2>&1 &
  tpid=$!
  echo "tunnel up: $MIS_PUBLIC_URL (log: ~/.config/mis/cloudflared.log)" >&2
fi
start "$cur"
if [ $watch = 0 ]; then
  prune
  wait "$main"
  exit
fi

# Watch: from here every failure is logged and the running version keeps serving. Every few
# seconds the orchestrator hears the builds and says which to start; main is fetched every
# INTERVAL s.
set +e
consider
step=5; [ "$INTERVAL" -lt $step ] && step=$INTERVAL
waited=0
while :; do
  nap "$step"
  waited=$((waited + step))
  if [ $waited -ge "$INTERVAL" ]; then
    waited=0
    if ! on_clean_main; then
      log "$REPO is not clean main; not updating"
    elif git -C "$REPO" fetch -q origin main && git -C "$REPO" merge -q --ff-only origin/main; then
      consider
      [ -n "$ready$prev" ] && checks && describe
    else
      log "can't fetch or fast-forward to origin/main"
    fi
  fi
  sha=$(next)
  case $sha in
    '') ;;
    "$ready" | "$prev") go "$sha" ;;
    *) log "asked to start $(short "$sha"), which isn't ready or previous" ;;
  esac
done
